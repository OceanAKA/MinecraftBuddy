# Copy this file to .env and fill it in.

# Your Anthropic API key — https://console.anthropic.com > API keys
ANTHROPIC_API_KEY=sk-ant-...

# Where the bot connects. For a singleplayer world opened to LAN, host stays localhost
# and the port is shown in chat when you click "Open to LAN":
#   "Local game hosted on port 54321"
# NOTE: this port changes EVERY time you reopen the world to LAN.
MC_HOST=localhost
MC_PORT=

# What the bot is called in game
BOT_USERNAME=ClaudeBuddy

# Which Claude model powers the brain
CLAUDE_MODEL=claude-opus-4-8
